<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>serverless</AssemblyName>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.9.1" />

  </ItemGroup>

  <ItemGroup>
    <!-- The manifest and catalog model, so what the installer writes is exactly what hosts and
         Bitween read. -->
    <ProjectReference Include="..\SW.Serverless.Contract\SW.Serverless.Contract.csproj" />
    <!-- Everything the commands do; this project is only the command line over it. -->
    <ProjectReference Include="..\SW.Serverless.Tooling\SW.Serverless.Tooling.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SW.Serverless.Installer.UnitTests" />
    <InternalsVisibleTo Include="SW.Serverless.CompatibilityTests" />
  </ItemGroup>


</Project>
