<Project Sdk="Microsoft.NET.Sdk">

    <!-- The manifest reader as published in SimplyWorks.Serverless.Contract 10.0.2, the first to
         read manifests and what released Bitween reads them with. Never upgrade this reference:
         it is the old side of the compatibility tests. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SimplyWorks.Serverless.Contract" Version="10.0.2" />
    </ItemGroup>

</Project>
