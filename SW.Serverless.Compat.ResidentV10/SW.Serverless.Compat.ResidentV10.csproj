<Project Sdk="Microsoft.NET.Sdk">
  <!-- A resident adapter built against the SDK as PUBLISHED, so the current host is held to the
       protocol that SDK speaks rather than to whatever this repository's SDK happens to say. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SimplyWorks.Serverless.Sdk" Version="10.0.0" />
  </ItemGroup>
</Project>
