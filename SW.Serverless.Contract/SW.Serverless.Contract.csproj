<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>disable</Nullable>
        <PackageId>SimplyWorks.Serverless.Contract</PackageId>
        <Authors>Simplify9</Authors>
        <Product>SimplyWorks.Serverless.Contract</Product>
        <PackageProjectUrl>https://github.com/simplify9/Serverless</PackageProjectUrl>
        <RepositoryUrl>https://github.com/simplify9/Serverless</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Copyright>Simplify9</Copyright>
        <Company>Simplify9</Company>
        <Description>Wire contract shared by the SW.Serverless host and the adapter SDK: the protocol-2 envelope used by resident and orchestrated adapters.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Google.Protobuf" Version="3.28.3" />
        <PackageReference Include="Grpc.Core.Api" Version="2.66.0" />
        <PackageReference Include="Grpc.Tools" Version="2.66.0" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="Protos\adapter.proto" GrpcServices="Both" />
    </ItemGroup>

</Project>
