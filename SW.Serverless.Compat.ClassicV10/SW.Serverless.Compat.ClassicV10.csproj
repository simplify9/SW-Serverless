<Project Sdk="Microsoft.NET.Sdk">
  <!-- A classic adapter built against the SDK as PUBLISHED, not this repository's: the shape of
       every adapter already in production, which the current host must keep running. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SimplyWorks.PrimitiveTypes" Version="10.0.1" />
    <PackageReference Include="SimplyWorks.Serverless.Sdk" Version="10.0.0" />
  </ItemGroup>
</Project>
