{
  "name": "ServerlessInstaller",
  "productName": "ServerlessInstaller",
  "version": "1.0.0",
  "description": "An Installer for Serverless Adapters",
  "build": {
    "extraResources": []
  },
  "main": ".webpack/main",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts ."
  },
  "keywords": [],
  "author": {
    "name": "shaheen-s",
    "email": "shaheen@simplify9.com"
  },
  "license": "MIT",
  "resolutions": {
    "json-schema": "0.4.0",
    "form-data": "2.5.6",
    "sha.js": "2.4.12",
    "cipher-base": "1.0.7",
    "elliptic": "6.6.1",
    "minimist": "1.2.8",
    "pbkdf2": "3.1.6",
    "plist": "3.0.5",
    "tar": "7.5.22",
    "ts-loader/loader-utils": "1.4.2",
    "html-webpack-plugin/loader-utils": "1.4.2",
    "webpack/loader-utils": "1.4.2",
    "copy-webpack-plugin/loader-utils": "2.0.4",
    "css-loader/loader-utils": "2.0.4",
    "node-loader/loader-utils": "2.0.4",
    "style-loader/loader-utils": "2.0.4"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "./icon.ico"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "installer_ui"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ],
      "plugins": [
        [
          "@electron-forge/plugin-webpack",
          {
            "mainConfig": "./webpack.main.config.js",
            "renderer": {
              "config": "./webpack.renderer.config.js",
              "entryPoints": [
                {
                  "html": "./src/index.html",
                  "js": "./src/renderer.ts",
                  "name": "main_window"
                }
              ]
            }
          }
        ]
      ]
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^6.0.0-beta.54",
    "@electron-forge/maker-deb": "^6.0.0-beta.54",
    "@electron-forge/maker-flatpak": "^6.0.0-beta.54",
    "@electron-forge/maker-rpm": "^6.0.0-beta.54",
    "@electron-forge/maker-snap": "^6.0.0-beta.54",
    "@electron-forge/maker-squirrel": "^6.0.0-beta.54",
    "@electron-forge/maker-zip": "^6.0.0-beta.54",
    "@electron-forge/plugin-webpack": "6.0.0-beta.54",
    "@marshallofsound/webpack-asset-relocator-loader": "^0.5.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^4.0.1",
    "@typescript-eslint/parser": "^4.0.1",
    "css-loader": "^4.2.1",
    "electron": "11.1.1",
    "eslint": "^7.6.0",
    "eslint-plugin-import": "^2.20.0",
    "fork-ts-checker-webpack-plugin": "^5.0.14",
    "node-loader": "^1.0.1",
    "style-loader": "^1.2.1",
    "ts-loader": "^8.0.2",
    "typescript": "^4.0.2"
  },
  "dependencies": {
    "@types/adm-zip": "^0.4.33",
    "adm-zip": "^0.5.1",
    "aws-sdk": "^2.829.0",
    "bootstrap": "^4.5.3",
    "copy-webpack-plugin": "6.2.1",
    "electron-squirrel-startup": "^1.0.0",
    "react": "^17.0.1",
    "react-bootstrap": "^1.4.0",
    "react-dom": "^17.0.1",
    "shell-path": "^2.1.0"
  }
}
