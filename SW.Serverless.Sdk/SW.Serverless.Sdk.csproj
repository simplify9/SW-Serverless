<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8</TargetFramework>
        <PackageId>SimplyWorks.Serverless.Sdk</PackageId>
        <Authors>Simplify9</Authors>
        <Product>SimplyWorks.Serverless.Sdk</Product>
        <PackageProjectUrl>https://github.com/simplify9/Serverless</PackageProjectUrl>
        <RepositoryUrl>https://github.com/simplify9/Serverless</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>icon.png</PackageIcon>
        <Copyright>Simplify9</Copyright>
        <Company>Simplify9</Company>
        <Description>SDK for developing .NET serverless adapters with the Runner class, logging utilities, and adapter communication protocols. See https://github.com/simplify9/SW-Serverless for full documentation.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
        <PackageReference Include="SimplyWorks.PrimitiveTypes" Version="8.1.5" />
        <PackageReference Include="Grpc.Net.Client" Version="2.66.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SW.Serverless.Contract\SW.Serverless.Contract.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Include="../icon.png">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
    </ItemGroup>

</Project>
